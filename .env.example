# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aurixon

# Session / cookies
SESSION_SECRET=replace-with-a-long-random-string

# Frontend URL (used for OAuth redirects and CORS)
CLIENT_URL=http://localhost:5173

# Public base URL for uploaded media (required in production)
PUBLIC_VIDEO_URL=https://your-public-media-host.example.com

# Google OAuth + YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
YOUTUBE_API_KEY=

# Facebook / Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/instagram/facebook/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/callback/tiktok

# Optional AI / analysis services
HUGGINGFACE_API_KEY=
ACOUSTID_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional feature flags
ENABLE_STATUS_POLLER=false

# Optional tool paths
FPCCALC_PATH=
